{
  "name": "excro-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n site,escrow-api -c blue,green \"next dev\" \"npm --prefix escrow run dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "escrow:install": "npm --prefix escrow install",
    "escrow:dev": "npm --prefix escrow run dev",
    "escrow:test": "npm --prefix escrow test",
    "dev:site": "next dev"
  },
  "dependencies": {
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
